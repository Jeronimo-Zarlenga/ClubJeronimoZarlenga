# PostgreSQL local or hosted database URL. SQLite is used if this is omitted.
DATABASE_URL=sqlite:///./club_jeronimo.db

# Firebase project used to validate client ID tokens and send FCM messages.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use either this path locally or FIREBASE_SERVICE_ACCOUNT_JSON in a secret store.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Never commit the service-account JSON or put it in a public repository.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

# Comma-separated Firebase Auth UIDs allowed to manage venues and spaces.
ADMIN_UIDS=your-admin-firebase-uid

APP_TIMEZONE=America/Argentina/Buenos_Aires
# Use the Flutter web origin(s) when running a browser client; mobile ignores CORS.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
